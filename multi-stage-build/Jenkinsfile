pipeline {
    agent none

    triggers {
        // For GitHub Webhooks
        githubPush() 
        // OR for GitLab Webhooks (requires GitLab plugin)
        // gitlab(triggerOnPush: true, triggerOnMergeRequest: true, branchFilterType: 'All')
        
        // OR for traditional polling every 5 minutes if webhooks aren't possible
        // pollSCM('H/5 * * * *') 
    }

    stages {

        stage('Back-end-deployment')  {
            agent {docker { image 'maven:3.8.1-adoptopenjdk-11'} }
            steps {
                sh 'mvn --version'
            }
        }

        stage('Front-end-deployment') {
            agent {docker { image 'node:24-alpine' }}
            steps {
                sh 'node --version'
                sh 'ls /usr/local/bin'
            }
        }
    }
}